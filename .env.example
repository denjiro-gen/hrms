# ============================================================
# Bestlink HRMS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git!
# ============================================================

# ── LOCAL (MySQL/XAMPP) — leave DATABASE_URL empty to use these ──
DB_HOST=localhost
DB_NAME=bestlink_hrms
DB_USER=root
DB_PASS=

# ── PRODUCTION (Supabase PostgreSQL) ─────────────────────────────
# Paste your full Supabase connection string here.
# Get it from: Supabase Dashboard → Project Settings → Database → URI
# Format: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=

# ── App ──────────────────────────────────────────────────────────
BASE_URL=/hrms

# ── Email (Resend or Gmail) ──────────────────────────────────────
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_your_api_key_here
MAIL_FROM=hr@yourdomain.com
